# Empty deployment-input template. Copy outside the source tree and populate only
# from approved deployment and signing secret stores. Do not commit filled values.
# Release hosting requires an approved DNS name, private bind address, certificate,
# and matching private key. The host validates these inputs and refuses downgrade.
SIGHTLINE_TLS_HOST=
SIGHTLINE_TLS_BIND=
SIGHTLINE_TLS_PORT=8080
SIGHTLINE_TLS_CERT_FILE=
SIGHTLINE_TLS_KEY_FILE=
SIGHTLINE_TLS_PASSPHRASE_FILE=

# Android signing inputs are intentionally blank and must come from an approved
# signing process. Never use the Android debug key for release signing.
SIGHTLINE_KEYSTORE_PATH=
SIGHTLINE_KEYSTORE_PASSWORD=
SIGHTLINE_KEY_PASSWORD=
SIGHTLINE_KEY_ALIAS=

# Optional approved HTTPS update feed. Leave blank to keep update checks disabled.
SIGHTLINE_UPDATE_MANIFEST_URL=

# Public HTTPS privacy policy page approved for the Play app and listing.
SIGHTLINE_PRIVACY_POLICY_URL=

# Android release build property: -PsightlineLanTlsHost=<approved DNS FQDN>
